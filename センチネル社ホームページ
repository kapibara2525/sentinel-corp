<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Sentinel Corporation</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: "Segoe UI", "Hiragino Kaku Gothic ProN", sans-serif;
      background-color: #000;
      color: #fff;
      text-align: center;
    }

    /* 背景画像 */
    .hero {
      position: relative;
      height: 100vh;
      background: url("lv_0_20260109204532.jpeg") center / cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 黒オーバーレイ */
    .overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.6);
    }

    /* 中央コンテンツ */
    .content {
      position: relative;
      z-index: 1;
    }

    h1 {
      font-size: 42px;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 14px;
      color: #ccc;
      margin-bottom: 40px;
    }

    .buttons a {
      display: inline-block;
      margin: 10px;
      padding: 14px 36px;
      background: #fff;
      color: #000;
      border-radius: 999px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.2s;
    }

    .buttons a:hover {
      background: #ddd;
    }
  </style>
</head>

<body>

  <div class="hero">
    <div class="overlay"></div>

    <div class="content">
      <h1>Sentinel Corporation</h1>
      <div class="subtitle">Security & Strategic Operations</div>

      <div class="buttons">
        <a href="rules.html">ルールを見る</a>
        <a href="units.html">部隊紹介</a>
        <a href="executives.html">上層部紹介</a>
      </div>
    </div>
  </div>

</body>
</html>
